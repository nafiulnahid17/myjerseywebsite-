{
  "name": "myjerseywebsite",
  "main": "./artifacts/my-jersey/worker.mjs",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./artifacts/my-jersey/dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "my-jersey-public-media"
    }
  ]
}
